---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'rngdev — notes on building things.' } = Astro.props;
const pageTitle = title === 'rngdev' ? title : `${title} · rngdev`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="rngdev"
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">rngdev</a>
        <nav class="site-nav">
          <a href="/blog">blog</a>
          <a href="/about">about</a>
          <a href="/rss.xml">rss</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} rngdev</span>
        <span>Built with Astro</span>
      </div>
    </footer>
  </body>
</html>
